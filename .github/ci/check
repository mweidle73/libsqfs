#!/bin/sh

set -eu

step()
{
    printf '\n==== %s ====\n' "$1"
}

clean_build()
{
    if test -f Makefile; then
        make distclean
    fi
}

check_zstd_image()
{
    workdir=$(mktemp -d)
    trap 'rm -rf "$workdir"' EXIT HUP INT TERM

    mkdir -p "$workdir/source/etc"
    printf '%s\n' 'libsqfs zstd interoperability' \
        > "$workdir/source/etc/payload"

    ./examples/mksqfs --compressor zstd \
        "$workdir/source" "$workdir/zstd.squashfs"
    unsquashfs -s "$workdir/zstd.squashfs" |
        grep -F 'Compression zstd'
    test "$(unsquashfs -cat \
        "$workdir/zstd.squashfs" etc/payload)" = \
        'libsqfs zstd interoperability'

    rm -rf "$workdir"
    trap - EXIT HUP INT TERM
}

step 'Normal build: configure'
clean_build
./autogen.sh --disable-shared

step 'Normal build: compile'
make -j8

step 'Normal build: unit tests'
make check

step 'Normal build: Zstd interoperability'
check_zstd_image

step 'Sanitizer build: configure'
clean_build
./autogen.sh --disable-shared \
    CFLAGS='-O1 -g -fsanitize=address,undefined -fno-omit-frame-pointer' \
    LDFLAGS='-fsanitize=address,undefined'

step 'Sanitizer build: compile'
make -j8

step 'Sanitizer build: unit tests'
ASAN_OPTIONS='detect_leaks=1:halt_on_error=1' \
UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1' \
    make check
